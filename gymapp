<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0E0A0D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="LiftLog">
<title>LiftLog</title>
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' fill='%230E0A0D'/%3E%3Ctext x='90' y='118' font-size='96' text-anchor='middle' fill='%23FF2E93' font-family='sans-serif'%3E%E2%99%A5%3C/text%3E%3C/svg%3E">
<style>
:root{
  --bg:#0E0A0D; --surface:#191016; --surface2:#23151D; --line:#3A2430;
  --text:#FCEEF4; --muted:#C79BB0; --pink:#FF2E93; --pinkSoft:#FF9EC8;
  --pinkDim:#3A1428; --doneBg:#2A121F;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;background:var(--bg)}
body{
  font-family:'Inter',system-ui,-apple-system,"Segoe UI",sans-serif;
  color:var(--text);
  padding-bottom:calc(150px + env(safe-area-inset-bottom));
  max-width:560px;margin:0 auto;
  padding-top:env(safe-area-inset-top);
}
input{font-family:inherit}
input::placeholder{color:var(--muted);opacity:.6}
input:focus{outline:2px solid var(--pink);outline-offset:1px}
button{font-family:inherit;cursor:pointer}
button:focus-visible{outline:2px solid var(--pink);outline-offset:2px}
.tapfx:active{transform:scale(.97)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

header{display:flex;justify-content:space-between;align-items:center;padding:16px 18px 8px}
.mark{font-weight:800;font-size:21px;letter-spacing:1px}
.mark span{color:var(--pink)}
.soundBtn{background:var(--surface);color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:6px 12px;font-size:12px}

.track{display:flex;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:4px;margin:6px 14px 10px}
.trackBtn{flex:1;background:transparent;color:var(--muted);border:none;border-radius:9px;padding:9px 0;font-size:14px;font-weight:700}
.trackBtn.on{background:linear-gradient(135deg,var(--pink),var(--pinkSoft));color:#1a0510}

nav{display:flex;gap:8px;padding:0 14px 12px}
.tab{flex:1;background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:10px;padding:9px 0;font-size:14px;font-weight:600}
.tab.on{background:var(--text);color:var(--bg);border-color:var(--text)}
main{padding:0 14px}

.dayRow{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none}
.dayRow::-webkit-scrollbar{display:none}
.dayChip{white-space:nowrap;background:var(--surface);color:var(--muted);border:1px solid var(--line);border-radius:8px;padding:7px 13px;font-size:13px;font-weight:700}
.dayChip.on{background:var(--pinkDim);color:var(--pink);border-color:var(--pink)}
.dayTitle{width:100%;background:transparent;color:var(--text);border:none;font-size:22px;font-weight:800;padding:4px 4px 12px;letter-spacing:-.3px}

.tagLabel{color:var(--pinkSoft);font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:6px 4px 8px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:10px}
.card.soft{background:var(--surface2);border-color:var(--pinkDim)}
.exHead{display:flex;align-items:center;gap:8px}
.exName{flex:1;background:transparent;color:var(--text);border:none;font-size:15.5px;font-weight:700;padding:2px;min-width:0}
.target{color:var(--pinkSoft);font-size:13px;font-variant-numeric:tabular-nums;white-space:nowrap}
.xBtn{background:transparent;color:var(--muted);border:none;font-size:14px;padding:4px}
.note{color:var(--muted);font-size:12px;font-style:italic;padding:2px 2px 4px}

.gridHead,.setRow{display:grid;grid-template-columns:32px 1fr 1fr 92px;gap:8px;align-items:center}
.gridHead{color:var(--muted);font-size:10px;letter-spacing:1px;padding:8px 2px 6px}
.setRow{margin-bottom:8px;padding:4px 2px;border-radius:10px}
.setRow.done{background:var(--doneBg)}
.setNo{color:var(--muted);font-size:14px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums}
.numIn{width:100%;background:var(--surface2);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:11px 8px;font-size:17px;font-weight:600;text-align:center;font-variant-numeric:tabular-nums}
.rowBtns{display:flex;gap:6px;justify-content:flex-end}
.check{width:40px;height:40px;background:var(--surface2);color:var(--muted);border:1px solid var(--line);border-radius:10px;font-size:17px;font-weight:800}
.check.on{background:var(--pink);color:#fff;border-color:var(--pink)}
.miniX{width:26px;height:40px;background:transparent;color:var(--muted);border:none;font-size:20px}
.addSet{width:100%;background:transparent;color:var(--pinkSoft);border:1px dashed var(--line);border-radius:9px;padding:9px 0;font-size:13px;font-weight:600;margin-top:2px}
.addEx{width:100%;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:14px;padding:13px 0;font-size:14px;font-weight:700;margin-bottom:16px}

.summary{display:flex;align-items:center;gap:16px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px 16px}
.sumNum{font-size:26px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}
.sumLbl{font-size:11px;color:var(--muted);margin-top:3px}
.finish{margin-left:auto;background:linear-gradient(135deg,var(--pink),var(--pinkSoft));color:#1a0510;border:none;border-radius:12px;padding:13px 18px;font-size:15px;font-weight:800}
.finish:disabled{background:var(--surface2);color:var(--muted);cursor:not-allowed}
.tip{color:var(--muted);font-size:12px;line-height:1.5;padding:14px 4px 0;text-align:center}

.empty{color:var(--muted);text-align:center;padding:60px 20px;font-size:15px}
.histHead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.badge{color:var(--pinkSoft);font-size:11px;margin-right:6px}
.histLine{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:4px 0}
.histLine .r{color:var(--muted);font-variant-numeric:tabular-nums;text-align:right}
.histFoot{margin-top:10px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.vol{color:var(--pink);font-weight:700;font-variant-numeric:tabular-nums}
.copyBtn{background:var(--surface2);color:var(--pinkSoft);border:1px solid var(--line);border-radius:8px;padding:7px 12px;font-size:12px;font-weight:700}
.copyBtn.on{background:var(--pink);color:#fff;border-color:var(--pink)}
.ghost{width:100%;background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:10px;padding:11px 0;font-size:13px;margin-top:8px}

.chartWrap{display:flex;align-items:flex-end;gap:6px;height:70px}
.bar{flex:1;min-height:3px;background:linear-gradient(var(--pink),var(--pinkSoft));border-radius:3px}

#restBar{position:fixed;bottom:0;left:0;right:0;max-width:560px;margin:0 auto;background:var(--surface2);border-top:2px solid var(--pink);padding:14px 16px calc(18px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:14px;box-shadow:0 -8px 30px rgba(0,0,0,.55)}
#restBar[hidden]{display:none}
.restLeft{text-align:center;min-width:78px}
.restTime{font-size:34px;font-weight:800;color:var(--pink);font-variant-numeric:tabular-nums;line-height:1}
.restLbl{font-size:11px;color:var(--muted);letter-spacing:1px;text-transform:uppercase}
.restBtns{display:flex;flex-wrap:wrap;gap:6px;flex:1;justify-content:flex-end}
.preset{background:var(--surface);color:var(--muted);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13px;font-weight:600}
.preset.on{background:var(--pinkDim);color:var(--pink);border-color:var(--pink)}
.restAct{background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:13px;font-weight:700}
.restAct.resume{background:var(--pinkSoft);color:#1a0510;border-color:var(--pinkSoft)}
.restAct.skip{background:var(--pink);color:#fff;border-color:var(--pink)}
#restProg{position:absolute;bottom:0;left:0;height:3px;background:var(--pinkSoft);transition:width .25s linear}
</style>
</head>
<body>

<header>
  <span class="mark">LIFT<span>&hearts;</span>LOG</span>
  <button class="soundBtn tapfx" id="soundBtn"></button>
</header>

<div class="track">
  <button class="trackBtn tapfx" data-track="gym">Gym</button>
  <button class="trackBtn tapfx" data-track="home">Home</button>
</div>

<nav>
  <button class="tab tapfx" data-tab="lift">Workout</button>
  <button class="tab tapfx" data-tab="history">History</button>
</nav>

<main id="main"></main>

<div id="restBar" hidden>
  <div class="restLeft">
    <div class="restTime" id="restTime">0:00</div>
    <div class="restLbl" id="restLbl">rest</div>
  </div>
  <div class="restBtns">
    <button class="preset tapfx" data-preset="60">60s</button>
    <button class="preset tapfx" data-preset="90">90s</button>
    <button class="preset tapfx" data-preset="120">120s</button>
    <button class="restAct tapfx" id="add15">+15</button>
    <button class="restAct tapfx" id="pauseBtn">&#9208; pause</button>
    <button class="restAct skip tapfx" id="skipBtn">skip</button>
  </div>
  <div id="restProg"></div>
</div>

<script>
(function(){
"use strict";

/* ---------- helpers ---------- */
var uid=function(){return Math.random().toString(36).slice(2,9);};
function ex(name,sets,reps,tag,note){
  return {id:uid(),name:name,targetSets:sets,targetReps:reps||"",tag:tag||"Main",note:note||"",lastWeight:""};
}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}

/* ---------- program ---------- */
function defaultPlan(){return {
gym:[
 {id:uid(),name:"Day 1 \u00b7 Legs",exercises:[
  ex("Hip bridge",2,"","Warm-up"),
  ex("Side walk, right \u2014 band",2,"","Warm-up"),
  ex("Side walk, left \u2014 band",2,"","Warm-up"),
  ex("Air squat",2,"","Warm-up"),
  ex("Seated leg press",3),
  ex("Stiff-leg deadlift \u2014 DB",3),
  ex("Seated leg curl",3),
  ex("Goblet squat \u2014 DB, box",3),
  ex("Hip thrust \u2014 machine",4),
  ex("Standing calf raise",3)]},
 {id:uid(),name:"Day 2 \u00b7 Upper",exercises:[
  ex("Incline bench DB row",3),
  ex("Incline DB bench press",3),
  ex("Lat pulldown, wide grip",3),
  ex("Shoulder press \u2014 plate-loaded",3),
  ex("Lateral raise, right \u2014 pulley",3),
  ex("Lateral raise, left \u2014 pulley",3),
  ex("Triceps extension \u2014 pulley",3),
  ex("Biceps curl, standing alt \u2014 DB",3)]},
 {id:uid(),name:"Day 3 \u00b7 Legs",exercises:[
  ex("Treadmill",1,"5 min","Warm-up"),
  ex("Squat \u2014 Smith machine",3),
  ex("Deadlift \u2014 DB",3),
  ex("Seated leg curl",3),
  ex("Hip thrust \u2014 machine",4),
  ex("Seated leg extension",3),
  ex("Leg abduction \u2014 machine",3)]},
 {id:uid(),name:"Day 4 \u00b7 Upper + Core",exercises:[
  ex("One-arm row, right \u2014 DB",4),
  ex("One-arm row, left \u2014 DB",4),
  ex("Bench press \u2014 DB",4),
  ex("Incline push-up \u2014 box",4),
  ex("Band face pulls",4),
  ex("Lateral raise \u2014 DB",3),
  ex("Hammer curl \u2014 DB",3),
  ex("Cross-arm tricep pushdown, left \u2014 band",3),
  ex("Cross-arm tricep pushdown, right \u2014 band",3),
  ex("Dead bug, alternating",3,"","Core"),
  ex("Lying leg raise",3,"","Core"),
  ex("Side plank, right",3,"","Core"),
  ex("Side plank, left",3,"","Core")]}
],
home:[
 {id:uid(),name:"Mon \u00b7 Lower Strength",exercises:[
  ex("Glute bridge",2,"15","Warm-up","2 rounds"),
  ex("Bodyweight squat",2,"10","Warm-up","2 rounds"),
  ex("Band lateral walk",2,"15/side","Warm-up","2 rounds"),
  ex("Goblet squat",4,"10\u201312","Main","Heaviest Bowflex you can control"),
  ex("DB Romanian deadlift",4,"10","Main","3s down"),
  ex("Bench hip thrust",4,"12","Main","DB across hips"),
  ex("DB step-up",3,"10/leg","Main"),
  ex("Banded hamstring curl",3,"15","Main","Anchor band low"),
  ex("Standing calf raise",3,"20","Main","Holding DBs"),
  ex("Walking pad",1,"10\u201315 min","Finisher","Optional")]},
 {id:uid(),name:"Tue \u00b7 Upper Strength",exercises:[
  ex("Band pull apart",1,"20","Warm-up"),
  ex("External rotation",1,"15","Warm-up"),
  ex("Arm circles",1,"20","Warm-up"),
  ex("Chest-supported DB row",4,"10\u201312","Main","Bench at incline"),
  ex("Incline DB press",4,"10","Main","Neutral grip"),
  ex("One-arm DB row",3,"12/side","Main"),
  ex("Seated DB shoulder press",3,"10","Main"),
  ex("DB lateral raise",3,"15","Main"),
  ex("Hammer curl",3,"12","Main"),
  ex("Band tricep pressdown",3,"15","Main")]},
 {id:uid(),name:"Thu \u00b7 Lower \u00b7 Glutes",exercises:[
  ex("Glute bridge",2,"15","Warm-up","2 rounds"),
  ex("Band walks",2,"20","Warm-up","2 rounds"),
  ex("Air squats",2,"10","Warm-up","2 rounds"),
  ex("DB hip thrust",4,"15","Main"),
  ex("DB Romanian deadlift",4,"12","Main"),
  ex("DB sumo squat",3,"12","Main"),
  ex("DB step-up",3,"12/leg","Main"),
  ex("Banded abduction",3,"25","Main"),
  ex("Frog pumps",3,"30","Main"),
  ex("Peloton",1,"15\u201320 min","Finisher","Zone 2, optional")]}
]};}

/* ---------- storage: browser localStorage ---------- */
var K="liftlog:v1:";
function load(key,def){
  try{var raw=localStorage.getItem(K+key);return raw?JSON.parse(raw):def;}
  catch(e){return def;}
}
function save(key,val){
  try{localStorage.setItem(K+key,JSON.stringify(val));}
  catch(e){console.warn("save failed",e);}
}

/* ---------- state ---------- */
var storedPlan=load("plan",null);
var plan=storedPlan||defaultPlan();
var freshInstall=!storedPlan;
var history=load("history",[]);
var settings=load("settings",{rest:90,sound:true});
var active=load("active",null)||{};
var track=(active.track==="home"||active.track==="gym")?active.track:"gym";
var dayId=null, logs=active.logs||{}, tab="lift";
(function(){
  var ds=plan[track];
  dayId=(active.dayId&&ds.some(function(d){return d.id===active.dayId;}))?active.dayId:ds[0].id;
})();

function persistPlan(){save("plan",plan);}
function persistActive(){save("active",{track:track,dayId:dayId,logs:logs});}
function persistHistory(){save("history",history);}
function persistSettings(){save("settings",settings);}

function days(){return plan[track];}
function curDay(){
  var ds=days();
  for(var i=0;i<ds.length;i++){if(ds[i].id===dayId)return ds[i];}
  return ds[0];
}
function rowsFor(e){
  if(!logs[e.id]){
    var arr=[];
    for(var i=0;i<e.targetSets;i++)arr.push({weight:e.lastWeight||"",reps:"",done:false});
    logs[e.id]=arr;
  }
  return logs[e.id];
}
function volume(){
  var d=curDay(),t=0;
  d.exercises.forEach(function(e){
    rowsFor(e).forEach(function(r){
      if(r.done)t+=(parseFloat(r.weight)||0)*(parseFloat(r.reps)||0);
    });
  });
  return t;
}
function doneCount(){
  var d=curDay(),n=0;
  d.exercises.forEach(function(e){
    rowsFor(e).forEach(function(r){if(r.done)n++;});
  });
  return n;
}

/* ---------- audio blip ---------- */
var actx=null;
function blip(){
  if(!settings.sound)return;
  try{
    var AC=window.AudioContext||window.webkitAudioContext;
    if(!actx)actx=new AC();
    if(actx.state==="suspended")actx.resume();
    var o=actx.createOscillator(),g=actx.createGain();
    o.type="sine";o.frequency.value=720;
    g.gain.setValueAtTime(0.0001,actx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.11,actx.currentTime+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001,actx.currentTime+0.34);
    o.connect(g);g.connect(actx.destination);
    o.start();o.stop(actx.currentTime+0.35);
  }catch(e){}
}

/* ---------- rest timer ---------- */
var rest=null, tick=null, fired=false;
var restBar=document.getElementById("restBar");
var restTimeEl=document.getElementById("restTime");
var restLblEl=document.getElementById("restLbl");
var restProg=document.getElementById("restProg");

function remaining(){
  if(!rest)return 0;
  if(rest.paused!=null)return rest.paused;
  return Math.max(0,Math.ceil((rest.end-Date.now())/1000));
}
function startRest(){
  rest={end:Date.now()+settings.rest*1000,total:settings.rest,paused:null};
  fired=false;runTick();
}
function runTick(){
  if(tick)clearInterval(tick);
  paintRest();
  if(!rest)return;
  tick=setInterval(paintRest,250);
}
function paintRest(){
  if(!rest){restBar.hidden=true;if(tick){clearInterval(tick);tick=null;}return;}
  restBar.hidden=false;
  var s=remaining();
  restTimeEl.textContent=Math.floor(s/60)+":"+String(s%60).padStart(2,"0");
  restLblEl.textContent=s===0?"go \u{1F497}":(rest.paused!=null?"paused":"rest");
  restProg.style.width=(rest.total?(s/rest.total)*100:0)+"%";
  if(s===0&&!fired){fired=true;blip();}
  if(s>0)fired=false;
}
document.getElementById("add15").onclick=function(){
  if(!rest)return;
  if(rest.paused!=null){rest.paused+=15;}else{rest.end+=15000;}
  rest.total+=15;paintRest();
};
document.getElementById("pauseBtn").onclick=function(){
  if(!rest)return;
  if(rest.paused!=null){rest.end=Date.now()+rest.paused*1000;rest.paused=null;
    this.textContent="\u23F8 pause";this.classList.remove("resume");runTick();}
  else{rest.paused=remaining();this.textContent="\u25B6 resume";this.classList.add("resume");
    if(tick){clearInterval(tick);tick=null;}paintRest();}
};
document.getElementById("skipBtn").onclick=function(){
  rest=null;
  var pb=document.getElementById("pauseBtn");
  pb.textContent="\u23F8 pause";pb.classList.remove("resume");
  paintRest();
};
Array.prototype.forEach.call(document.querySelectorAll("[data-preset]"),function(b){
  b.onclick=function(){
    settings.rest=parseInt(b.dataset.preset,10);persistSettings();paintPresets();
  };
});
function paintPresets(){
  Array.prototype.forEach.call(document.querySelectorAll("[data-preset]"),function(b){
    b.classList.toggle("on",parseInt(b.dataset.preset,10)===settings.rest);
  });
}

/* ---------- header controls ---------- */
var soundBtn=document.getElementById("soundBtn");
function paintSound(){soundBtn.textContent=settings.sound?"\u{1F514} blip":"\u{1F515} silent";}
soundBtn.onclick=function(){settings.sound=!settings.sound;persistSettings();paintSound();};

Array.prototype.forEach.call(document.querySelectorAll("[data-track]"),function(b){
  b.onclick=function(){
    track=b.dataset.track;dayId=plan[track][0].id;persistActive();render();
  };
});
Array.prototype.forEach.call(document.querySelectorAll("[data-tab]"),function(b){
  b.onclick=function(){tab=b.dataset.tab;render();};
});

/* ---------- notion block ---------- */
function notionBlock(s){
  var d=new Date(s.date);
  var iso=d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
  var nice=d.toLocaleDateString(undefined,{month:"short",day:"numeric"});
  var setsDone=0;s.entries.forEach(function(e){setsDone+=e.sets.length;});
  var tc=s.track==="home"?"Home":"Gym";
  var details=s.entries.map(function(e){
    return "- "+e.name+": "+e.sets.map(function(x){
      return (x.weight||"\u2013")+"\u00d7"+(x.reps||"\u2013");}).join(", ");
  }).join("\n");
  return "WORKOUT LOG \u2014 sync to Notion\nSession: "+tc+" \u00b7 "+s.dayName+" \u2014 "+nice+
   "\nDate: "+iso+"\nTrack: "+tc+"\nDay: "+s.dayName+"\nVolume: "+s.volume+
   "\nSets Done: "+setsDone+"\nDetails:\n"+details;
}
function copyText(t,btn){
  function ok(){btn.textContent="\u2713 copied";btn.classList.add("on");
    setTimeout(function(){btn.textContent="Copy for Notion";btn.classList.remove("on");},1600);}
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(t).then(ok,function(){fallback();});
  }else fallback();
  function fallback(){
    try{var ta=document.createElement("textarea");ta.value=t;ta.style.position="fixed";
      ta.style.opacity="0";document.body.appendChild(ta);ta.select();
      document.execCommand("copy");document.body.removeChild(ta);ok();}catch(e){}
  }
}

/* ---------- render ---------- */
var main=document.getElementById("main");

function render(){
  Array.prototype.forEach.call(document.querySelectorAll("[data-track]"),function(b){
    b.classList.toggle("on",b.dataset.track===track);});
  Array.prototype.forEach.call(document.querySelectorAll("[data-tab]"),function(b){
    b.classList.toggle("on",b.dataset.tab===tab);});
  paintSound();paintPresets();
  main.innerHTML = tab==="lift" ? liftHTML() : historyHTML();
  if(tab==="lift")wireLift(); else wireHistory();
}

function liftHTML(){
  var d=curDay(),h="",lastTag=null;
  h+='<div class="dayRow">';
  days().forEach(function(x){
    h+='<button class="dayChip tapfx'+(x.id===dayId?' on':'')+'" data-day="'+x.id+'">'+
       esc(x.name.split("\u00b7")[0].trim())+'</button>';
  });
  h+='</div>';
  h+='<input class="dayTitle" id="dayTitle" value="'+esc(d.name)+'" aria-label="day name">';

  d.exercises.forEach(function(e){
    var soft=(e.tag==="Warm-up"||e.tag==="Finisher");
    if(e.tag!==lastTag){h+='<div class="tagLabel">'+esc(e.tag)+'</div>';lastTag=e.tag;}
    h+='<section class="card'+(soft?' soft':'')+'" data-ex="'+e.id+'">';
    h+='<div class="exHead"><input class="exName" data-exname="'+e.id+'" value="'+esc(e.name)+'" aria-label="exercise">'+
       '<span class="target">'+(e.targetReps?e.targetSets+"\u00d7"+esc(e.targetReps):e.targetSets+" sets")+'</span>'+
       '<button class="xBtn tapfx" data-rmex="'+e.id+'" aria-label="remove">\u2715</button></div>';
    if(e.note)h+='<div class="note">'+esc(e.note)+'</div>';
    h+='<div class="gridHead"><span>SET</span><span>WEIGHT</span><span>REPS</span><span></span></div>';
    rowsFor(e).forEach(function(r,i){
      h+='<div class="setRow'+(r.done?' done':'')+'" data-row="'+e.id+'|'+i+'">'+
         '<span class="setNo">'+(i+1)+'</span>'+
         '<input class="numIn" inputmode="decimal" data-f="weight" data-k="'+e.id+'|'+i+'" value="'+esc(r.weight)+'" placeholder="'+esc(e.lastWeight||"\u2014")+'" aria-label="weight">'+
         '<input class="numIn" inputmode="numeric" data-f="reps" data-k="'+e.id+'|'+i+'" value="'+esc(r.reps)+'" placeholder="'+esc(e.targetReps||"\u2014")+'" aria-label="reps">'+
         '<div class="rowBtns">'+
         '<button class="check tapfx'+(r.done?' on':'')+'" data-done="'+e.id+'|'+i+'" aria-label="done">\u2713</button>'+
         '<button class="miniX tapfx" data-rmset="'+e.id+'|'+i+'" aria-label="remove set">\u2013</button>'+
         '</div></div>';
    });
    h+='<button class="addSet tapfx" data-addset="'+e.id+'">+ set</button>';
    h+='</section>';
  });

  h+='<button class="addEx tapfx" id="addEx">+ add exercise</button>';
  h+='<div class="summary">'+
     '<div><div class="sumNum" id="sumSets">'+doneCount()+'</div><div class="sumLbl">sets done</div></div>'+
     '<div><div class="sumNum" id="sumVol">'+Math.round(volume()).toLocaleString()+'</div><div class="sumLbl">volume</div></div>'+
     '<button class="finish tapfx" id="finishBtn"'+(doneCount()?'':' disabled')+'>Finish &amp; save</button></div>';
  h+='<p class="tip">Your music keeps playing \u2014 this never grabs audio. Only sound is an optional soft blip when rest ends.</p>';
  h+='<button class="ghost tapfx" id="backupBtn">Download backup</button>';
  return h;
}

function historyHTML(){
  if(!history.length)return '<div class="empty">No sessions yet. Finish a workout and it lands here.</div>';
  var h="";
  var pts=history.slice(0,12).reverse();
  if(pts.length>1){
    var max=Math.max.apply(null,pts.map(function(p){return p.volume;}).concat([1]));
    h+='<div class="card"><div class="tagLabel" style="padding:0 0 10px">Volume trend</div><div class="chartWrap">';
    pts.forEach(function(p){h+='<div class="bar" style="height:'+((p.volume/max)*100)+'%"></div>';});
    h+='</div></div>';
  }
  history.forEach(function(s){
    h+='<section class="card">';
    h+='<div class="histHead"><span style="font-weight:700"><span class="badge">'+
       (s.track==="home"?"HOME":"GYM")+'</span>'+esc(s.dayName)+'</span>'+
       '<span style="color:var(--muted);font-size:12px">'+
       new Date(s.date).toLocaleDateString(undefined,{month:"short",day:"numeric"})+'</span></div>';
    s.entries.forEach(function(e){
      h+='<div class="histLine"><span>'+esc(e.name)+'</span><span class="r">'+
         e.sets.map(function(x){return (esc(x.weight)||"\u2013")+"\u00d7"+(esc(x.reps)||"\u2013");}).join("  \u00b7  ")+
         '</span></div>';
    });
    h+='<div class="histFoot"><span class="vol">'+s.volume.toLocaleString()+' vol</span>'+
       '<button class="copyBtn tapfx" data-copy="'+s.id+'">Copy for Notion</button></div>';
    h+='</section>';
  });
  h+='<button class="ghost tapfx" id="clearHist">Clear history</button>';
  return h;
}

/* ---------- wiring ---------- */
function wireLift(){
  Array.prototype.forEach.call(main.querySelectorAll("[data-day]"),function(b){
    b.onclick=function(){dayId=b.dataset.day;persistActive();render();};
  });
  var dt=main.querySelector("#dayTitle");
  dt.oninput=function(){curDay().name=dt.value;persistPlan();};

  Array.prototype.forEach.call(main.querySelectorAll("[data-exname]"),function(inp){
    inp.oninput=function(){
      var d=curDay();
      d.exercises.forEach(function(e){if(e.id===inp.dataset.exname)e.name=inp.value;});
      persistPlan();
    };
  });
  Array.prototype.forEach.call(main.querySelectorAll("[data-rmex]"),function(b){
    b.onclick=function(){
      var id=b.dataset.rmex,d=curDay();
      d.exercises=d.exercises.filter(function(e){return e.id!==id;});
      delete logs[id];persistPlan();persistActive();render();
    };
  });

  /* value edits: update state only, keep focus */
  Array.prototype.forEach.call(main.querySelectorAll("[data-k]"),function(inp){
    inp.oninput=function(){
      var p=inp.dataset.k.split("|"),id=p[0],i=parseInt(p[1],10);
      if(!logs[id])return;
      logs[id][i][inp.dataset.f]=inp.value;
      persistActive();refreshSummary();
    };
  });

  Array.prototype.forEach.call(main.querySelectorAll("[data-done]"),function(b){
    b.onclick=function(){
      var p=b.dataset.done.split("|"),id=p[0],i=parseInt(p[1],10);
      var r=logs[id][i];r.done=!r.done;
      b.classList.toggle("on",r.done);
      var row=main.querySelector('[data-row="'+id+'|'+i+'"]');
      if(row)row.classList.toggle("done",r.done);
      if(r.done){
        if(r.weight){
          plan[track].forEach(function(d){d.exercises.forEach(function(e){
            if(e.id===id)e.lastWeight=r.weight;});});
          persistPlan();
        }
        startRest();
      }
      persistActive();refreshSummary();
    };
  });

  Array.prototype.forEach.call(main.querySelectorAll("[data-addset]"),function(b){
    b.onclick=function(){
      var id=b.dataset.addset,rows=logs[id];
      var last=rows[rows.length-1];
      rows.push({weight:(last&&last.weight)||"",reps:"",done:false});
      persistActive();render();
    };
  });
  Array.prototype.forEach.call(main.querySelectorAll("[data-rmset]"),function(b){
    b.onclick=function(){
      var p=b.dataset.rmset.split("|"),id=p[0],i=parseInt(p[1],10);
      logs[id].splice(i,1);persistActive();render();
    };
  });

  main.querySelector("#addEx").onclick=function(){
    curDay().exercises.push(ex("New exercise",3));persistPlan();render();
  };
  main.querySelector("#finishBtn").onclick=finish;
  main.querySelector("#backupBtn").onclick=function(){
    var data={plan:plan,history:history,settings:settings,exported:new Date().toISOString()};
    var blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
    var a=document.createElement("a");
    a.href=URL.createObjectURL(blob);
    a.download="liftlog-backup-"+new Date().toISOString().slice(0,10)+".json";
    document.body.appendChild(a);a.click();document.body.removeChild(a);
  };
}

function refreshSummary(){
  var a=main.querySelector("#sumSets"),b=main.querySelector("#sumVol"),f=main.querySelector("#finishBtn");
  if(!a)return;
  var n=doneCount();
  a.textContent=n;
  b.textContent=Math.round(volume()).toLocaleString();
  f.disabled=!n;
}

function wireHistory(){
  Array.prototype.forEach.call(main.querySelectorAll("[data-copy]"),function(b){
    b.onclick=function(){
      var id=b.dataset.copy,s=null;
      history.forEach(function(x){if(x.id===id)s=x;});
      if(s)copyText(notionBlock(s),b);
    };
  });
  var c=main.querySelector("#clearHist");
  if(c)c.onclick=function(){
    if(confirm("Clear all history?")){history=[];persistHistory();render();}
  };
}

function finish(){
  var d=curDay(),entries=[];
  d.exercises.forEach(function(e){
    var sets=rowsFor(e).filter(function(r){return r.done;})
      .map(function(r){return {weight:r.weight,reps:r.reps};});
    if(sets.length)entries.push({name:e.name,sets:sets});
  });
  if(!entries.length)return;
  history.unshift({id:uid(),date:Date.now(),track:track,dayName:d.name,
    entries:entries,volume:Math.round(volume())});
  persistHistory();
  logs={};persistActive();
  rest=null;paintRest();
  tab="history";render();
}

/* ---------- go ---------- */
if(freshInstall){persistPlan();persistActive();persistSettings();}
render();
paintRest();
})();
</script>
